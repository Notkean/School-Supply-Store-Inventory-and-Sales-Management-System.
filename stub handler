// GET /supplies — List all supplies
function listSupplies(request, response) {
  return response.status(200).json({
    status: 200,
    message: "listSupplies stub — returns all inventory items",
    data: null,
    error: null
  });
}

// GET /supplies/:id — View one supply
function showSupply(request, response) {
  const supplyId = request.params.id;
  return response.status(200).json({
    status: 200,
    message: "showSupply stub — returns one supply by ID",
    data: { id: supplyId },
    error: null
  });
}

